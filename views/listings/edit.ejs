 <%- layout("layouts/boilerplate") -%>
 <div class="row mt-3">
    <div class="col-8 offset-2">
<body>
    <h3>Edit your listing</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" type="text" value="<%=listing.title%>" class="form-control">
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label> 
        <textarea name="listing[description]" value="<%=listing.description%>" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label for="image" class="form-label">Image Link</label> 
        <input name="listing[image]" type="text" class="form-control" value="<%=listing.image%>">
    </div>
    <div class="row">
         <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price</label>
        <input name="listing[price]" type="number" class="form-control" value="<%=listing.price%>">
    </div>
    <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" type="text" value="<%=listing.country%>" class="form-control">
    </div>
    </div>
   
    <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" type="text" value="<%=listing.location%>" class="form-control">
  
    </div>
    <button class="btn btn-dark edit-btn mt-3">
        Edit
    </button>
    </form>
    </div>
 </div>
</body>
