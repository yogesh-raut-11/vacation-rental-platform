<%- layout("layouts/boilerplate") -%>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br><br>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings">
        <div class="mb-3">
            <label for="title" class="form-label">Add a catchy title</label>
            <input name="listing[title]" type="text" placeholder="Enter title" class="form-control">
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image URL/Link</label>
            <input name="listing[image][url]" type="text" placeholder="Enter Image URL" class="form-control">
        </div>
        <div class="row">

         <div class="mb-3 col-md-8">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" type="number" placeholder="1200" class="form-control">
        </div>
        <div class="mb-3 col-md-4">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" type="text" placeholder="India" class="form-control">          
        </div>

        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" type="text" placeholder=" Delhi-08" class="form-control">
        </div>
    <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
    </div>
    </div>
</body>
